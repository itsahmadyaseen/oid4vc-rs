# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
EXTERNAL_URL=http://localhost:3000

# Logging
RUST_LOG=oid4vc_server=debug,tower_http=debug

# Key material (paths to PEM files or inline base64)
ISSUER_KEY_P256_PEM=./keys/issuer_p256.pem
ISSUER_KEY_ED25519_PEM=./keys/issuer_ed25519.pem

# Credential issuer identity
CREDENTIAL_ISSUER_ID=http://localhost:3000
CREDENTIAL_ISSUER_NAME=OID4VC-RS Development Issuer

# Token settings
ACCESS_TOKEN_EXPIRY_SECS=3600
C_NONCE_EXPIRY_SECS=300
