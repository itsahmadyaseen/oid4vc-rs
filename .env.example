# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Public base URL. This is the Credential Issuer identifier and the audience
# wallets must put in their proof-of-possession JWTs.
EXTERNAL_URL=http://localhost:3000

# Logging
RUST_LOG=oid4vc_server=debug,tower_http=debug

# Signing keys (PKCS#8 PEM). Generated on first start if the file is absent.
# Leave unset to use ephemeral keys — credentials issued before a restart will
# no longer verify afterwards.
ISSUER_KEY_P256_PEM=./keys/issuer_p256.pem
ISSUER_KEY_ED25519_PEM=./keys/issuer_ed25519.pem

# Credential issuer identity
CREDENTIAL_ISSUER_NAME=OID4VC-RS Development Issuer

# Bearer token for the /admin/status/* endpoints. If unset, a random one is
# generated at startup and written to the log.
ADMIN_API_TOKEN=
